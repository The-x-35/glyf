{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryglyf.com/contracts/intent.schema.json",
  "title": "Intent",
  "description": "Keyboard → app handoff (SPEC §7.1). The keyboard writes an UNSIGNED intent to the App Group; the app simulates, requires Face ID, signs, executes. Intents are single-use, nonce-bound, and expire after 120s.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "createdAt", "expiresAt", "kind", "origin", "payload", "risk", "nonce"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "const": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "kind": { "type": "string", "enum": ["swap", "send", "sign_message", "dictation"] },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "glyfId", "rawText"],
      "properties": {
        "source": { "type": "string", "enum": ["typed", "clipboard", "glyf"] },
        "glyfId": { "type": ["string", "null"] },
        "rawText": { "type": "string", "description": "Exactly what the user saw. Treated as hostile input by every parser (SPEC §11.12)." }
      }
    },
    "payload": { "type": "object", "description": "Kind-specific; sub-schemas land with M3 (dictation) and M8 (swap/send)." },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "flags"],
      "properties": {
        "score": { "type": "number", "minimum": 0 },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nonce": { "type": "string", "minLength": 32, "description": "random-32-bytes-base64" }
  }
}
