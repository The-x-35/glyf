{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryglyf.com/contracts/result.schema.json",
  "title": "Result",
  "description": "App → keyboard result for a consumed intent (SPEC §7.2). The keyboard reads this and pastes a link; it never receives anything signed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["intentId", "status", "payload", "error", "completedAt"],
  "properties": {
    "intentId": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["success", "rejected", "failed", "expired"] },
    "payload": { "type": "object", "description": "signature + explorerUrl, or transcript" },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "completedAt": { "type": "string", "format": "date-time" }
  }
}
