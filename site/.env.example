# Neon Postgres for the waitlist (table: db/waitlist.sql). Server-side only.
# Neon dashboard → Connect → copy the pooled connection string.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Canonical site origin (metadata, canonical URL, OG tags). Optional; defaults to
# the primary domain. Must be the domain that serves the page, not one that redirects.
SITE_URL=https://www.tryglyf.com
