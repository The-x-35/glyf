# Neon Postgres for the waitlist (table: db/waitlist.sql). Server-side only.
# Neon dashboard → Connect → copy the pooled connection string.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Canonical site origin (metadata, canonical URL, OG tags). Optional.
SITE_URL=https://tryglyf.com
