OPENROUTER_API_KEY=<your-openrouter-key>
# ── Models (researched 2026-09-15) ────────────────────────────────────────
# No credit card: a Gemini key from https://aistudio.google.com/apikey and a
# Groq key from https://console.groq.com/keys (Free plan). Gemini 2.5
# Flash-Lite answers first in ~0.3s; Groq's free gpt-oss-120b does strict
# JSON for the Builder. Free tiers are capped (~500 Gemini requests/day,
# ~200K Groq tokens/day per model) — fine for now, not for launch.
#   FAST_MODELS=gemini:gemini-2.5-flash-lite,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,openrouter/free
#   SMART_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-2.5-flash
# With a card (~$12/month at 100k fast + 2k smart calls): same ids, paid
# Gemini + Groq Developer plan.
# Extra free pools, if a key is added: mistral:mistral-small-2603 (free plan
# credits), inception:mercury-2.5 (free tokens). Paid, fastest:
# cerebras:gpt-oss-120b. A provider without a key is skipped; a model that
# hits its rate limit is skipped until it recovers.
GEMINI_API_KEY=
GROQ_API_KEY=
# MISTRAL_API_KEY=
# INCEPTION_API_KEY=
# CEREBRAS_API_KEY=
PRIVY_APP_ID=<your-privy-app-id>
PRIVY_APP_SECRET=<your-privy-app-secret>
PORT=8787
GLYF_FEE_BPS=10
MOCK_AI=true
FREE_RUNS_PER_DAY=40

# ── Storage ───────────────────────────────────────────────────────────────
# Neon Postgres connection string (the pooled one, with ?sslmode=require).
# When it is set the server keeps everything in a single `glyf_kv` table
# (created on first use) instead of JSON files, which is what makes the
# serverless deploy durable: a Vercel function's disk dies with the instance.
#   local dev  → leave unset, state stays in server/data/*.json
#   production → required, set it in the Vercel project
# DATABASE_URL=
#
# Escape hatch: force one store regardless of the above. Use GLYF_STORE=file
# on a machine that has DATABASE_URL in the environment for something else and
# still wants the local JSON files. Tests always use memory.
#   GLYF_STORE=file | memory | postgres
# GLYF_STORE=

# Public origin of the deployed API. OAuth callbacks are built from this, so
# it must match the redirect URIs registered with each provider EXACTLY.
#   local dev  → leave unset (falls back to http://127.0.0.1:8787)
#   production → https://api.tryglyf.com
OAUTH_REDIRECT_BASE=https://api.tryglyf.com

# Per-provider overrides, only if a provider needs a different callback host.
# GOOGLE_REDIRECT_URI=https://api.tryglyf.com/oauth/google/callback

# Origin that shared mini-app page links point at (<base>/p/<id>). Unset in
# production means /act stops offering a page link at all.
#   production → https://api.tryglyf.com
# PUBLIC_BASE_URL=

# Provider credentials (each provider activates when its pair is present).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# GIPHY_API_KEY=

# ── §6.12 search suite ────────────────────────────────────────────────────
# Every vertical works without a key, but only just: web falls back to
# DuckDuckGo instant answers (Wikipedia-ish, not Google), YouTube returns a
# plain "search on YouTube" link because there is NO legitimate keyless
# YouTube search API, and Maps falls back to OpenStreetMap, which is a
# geocoder with no ratings and no open-now. Add these three and the suite
# becomes what the site demos. GET /search/status reports which are live.

# PRIMARY. Brave owns an independent index, so it is not reselling Google and
# carries none of the scraping exposure. $5/1k, $5 free credit a month (the
# credit requires a "POWERED BY BRAVE" line in the app). Their terms forbid
# caching results, so Brave responses skip our cache.
#   https://api-dashboard.search.brave.com
# BRAVE_SEARCH_KEY=

# OPT-IN FALLBACK ONLY. Serper returns true google.com SERPs with the answer
# box, and is 5-15x cheaper (2,500 free, then $1/1k) — but it resells scraped
# Google results, and Google is actively litigating that category
# (Google v. SerpApi, N.D. Cal.). Fine for prototyping; do not ship as the
# default, because the dependency can disappear on a court order.
#   https://serper.dev  →  API key
# SERPER_API_KEY=

# YouTube Data API v3. Free, but the DEFAULT quota is only 100 search calls
# PER DAY for the whole project — fine for TestFlight, not for launch. The
# quota-extension form needs a public URL, privacy policy and demo account,
# so file it early: https://support.google.com/youtube/contact/yt_api_form
#   https://console.cloud.google.com → enable "YouTube Data API v3" → key
# YOUTUBE_API_KEY=

# NO-CREDIT-CARD OPTION for the Maps tab. Geoapify is OpenStreetMap data
# behind a real hosted service: 3,000 requests/day free, 5 req/s, commercial
# use permitted, and signup needs NO billing account. Used whenever
# GOOGLE_PLACES_KEY is absent.
#   Trade-off: OSM has no ratings and no open-now, so cards show
#   name + distance + address. Coverage is good for chains and landmarks,
#   patchy for small local businesses.
#   Attribution required: 'Powered by Geoapify' with a link.
#   https://myprojects.geoapify.com  →  free API key
# GEOAPIFY_KEY=

# Google Places API (New) — the Maps tab. Ratings, open-now and photos are
# the Enterprise SKU ($35/1k, 1,000 calls free per month); names/addresses
# alone are Pro ($32/1k, 5,000 free). Also powers the nearby landing state.
#   https://console.cloud.google.com → enable "Places API (New)" → key
# GOOGLE_PLACES_KEY=

# Optional: the weather answer card. Same Cloud project as Places; falls back
# to GOOGLE_PLACES_KEY when unset. $0.15/1k with 10,000 free per month.
#   enable "Weather API" in the same project
# GOOGLE_WEATHER_KEY=

# Optional, off by default: a self-hosted Overpass instance for keyless
# "near me" category search. The public one regularly times out at 13s,
# which is worse than no result inside a keyboard.
# OVERPASS_API_BASE=https://overpass.yourhost.dev/api/interpreter

# With NO web key the Search tab is answers-only: the computed cards
# (arithmetic, sunset, time, currency, Wikipedia) still work and a tail row
# hands off to Google. It never shows a fabricated result list.
# OpenStreetMap place search is a DEVELOPMENT fallback, disabled when
# NODE_ENV=production — OSM caps the whole server at 1 request/second.
