OPENROUTER_API_KEY=<your-openrouter-key>
# ── Models and daily allowances ───────────────────────────────────────────
# Set in code, not here (server/src/env.ts, server/src/lib/limits.ts):
# FAST_MODELS, SMART_MODELS, SUGGEST_MODELS and the FREE_*_PER_DAY variables
# are no longer read. Hold space runs on Qwen 3.7 Flash, the Builder on Ling
# 3.0 Flash and the strip's suggestions on Qwen 3.7 Flash, each with Gemini
# 2.5 Flash-Lite behind it and Gemini's own free tier after that. Free: 20
# runs, 100 suggestions and 100 translations a day.
# Other pools, if a key is added: mistral:mistral-small-2603 (free plan
# credits), inception:mercury-2.5 (free tokens), cerebras:gpt-oss-120b (paid,
# fastest). A provider without a key is skipped; a model that hits its rate
# limit is skipped until it recovers.
GEMINI_API_KEY=
GROQ_API_KEY=
# MISTRAL_API_KEY=
# INCEPTION_API_KEY=
# CEREBRAS_API_KEY=
# Sign in (the app signs in natively; the server checks Apple's and Google's
# ID tokens and issues its own session). Client ids are public; the secret is
# not. Google Cloud Console → APIs & Services → Credentials:
#   Web application client → GOOGLE_CLIENT_ID (Android asks for this audience)
#   iOS client, bundle id com.arpit.glyf → GOOGLE_IOS_CLIENT_ID
#   Android client, package com.demo.glyf + signing SHA-1 (must exist, no value here)
# SESSION_SECRET: any long random string, e.g. `openssl rand -base64 48`.
SESSION_SECRET=<long-random-string>

# REVIEW_PASSWORD: the password App Store Connect's "Sign-In Information"
# hands to App Review (user name review@tryglyf.com). It signs the reviewer
# into one shared account with a month of Max. Set it once and leave it.
REVIEW_PASSWORD=<something-a-reviewer-can-type>
# REVIEW_MODE: true while a submission is in review — the sign-in screen
# shows its "App Review sign-in" link and the door works; false hides both.
REVIEW_MODE=true
APPLE_BUNDLE_ID=com.arpit.glyf
GOOGLE_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com

PORT=8787
GLYF_FEE_BPS=10
MOCK_AI=true

# ── Storage ───────────────────────────────────────────────────────────────
# Neon Postgres connection string (the pooled one, with ?sslmode=require).
# When it is set the server keeps everything in a single `glyf_kv` table
# (created on first use) instead of JSON files, which is what makes the
# serverless deploy durable: a Vercel function's disk dies with the instance.
#   local dev  → leave unset, state stays in server/data/*.json
#   production → required, set it in the Vercel project
# DATABASE_URL=
#
# Escape hatch: force one store regardless of the above. Use GLYF_STORE=file
# on a machine that has DATABASE_URL in the environment for something else and
# still wants the local JSON files. Tests always use memory.
#   GLYF_STORE=file | memory | postgres
# GLYF_STORE=

# Public origin of the deployed API. OAuth callbacks are built from this, so
# it must match the redirect URIs registered with each provider EXACTLY.
#   local dev  → leave unset (falls back to http://127.0.0.1:8787)
#   production → https://api.tryglyf.com
OAUTH_REDIRECT_BASE=https://api.tryglyf.com

# Per-provider overrides, only if a provider needs a different callback host.
# GOOGLE_REDIRECT_URI=https://api.tryglyf.com/oauth/google/callback

# Origin that shared mini-app page links point at (<base>/p/<id>). Unset in
# production means /act stops offering a page link at all.
#   production → https://api.tryglyf.com
# PUBLIC_BASE_URL=

# Provider credentials (each provider activates when its pair is present).
# GOOGLE_CLIENT_ID is the web client from the sign-in section above.
# GOOGLE_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# ── GIFs and stickers (the emoji board's tabs) ─────────────────────────────
# KLIPY is the free GIF API (Tenor's API closed on 2026-06-30; GIPHY charges
# past 100 calls an hour and forbids proxying). Get an app key at
# partner.klipy.com (test keys: 100 calls an hour; ask for production once
# the "Search KLIPY" attribution is live). The server only hands the key to
# signed-in phones (/media/config); KLIPY's terms want the phone to call it.
# Without a key the GIF tab says it isn't set up, and the Stickers tab uses
# Noto Animated Emoji, which needs no key.
# KLIPY_APP_KEY=
# Tests only: point phones at a fake KLIPY (qa/fake-klipy.mjs). Never in prod.
# KLIPY_BASE_URL=

# ── Booking pages (keyboard calendar) ─────────────────────────────────────
# Cal.com's public pages need no key. Call links are Google Meet, made by the
# keyboard with the person's own Google grant: nothing to set here.
# Tests only (qa/fake-scheduling.mjs), never in prod: CALCOM_API_BASE.

# ── §6.12 search suite ────────────────────────────────────────────────────
# Every vertical works without a key, but only just: web falls back to
# DuckDuckGo instant answers (Wikipedia-ish, not Google), YouTube returns a
# plain "search on YouTube" link because there is NO legitimate keyless
# YouTube search API, and Maps falls back to OpenStreetMap, which is a
# geocoder with no ratings and no open-now. Add these three and the suite
# becomes what the site demos. GET /search/status reports which are live.

# PRIMARY. Brave owns an independent index, so it is not reselling Google and
# carries none of the scraping exposure. $5/1k, $5 free credit a month (the
# credit requires a "POWERED BY BRAVE" line in the app). Their terms forbid
# caching results, so Brave responses skip our cache.
#   https://api-dashboard.search.brave.com
# BRAVE_SEARCH_KEY=

# OPT-IN FALLBACK ONLY. Serper returns true google.com SERPs with the answer
# box, and is 5-15x cheaper (2,500 free, then $1/1k) — but it resells scraped
# Google results, and Google is actively litigating that category
# (Google v. SerpApi, N.D. Cal.). Fine for prototyping; do not ship as the
# default, because the dependency can disappear on a court order.
#   https://serper.dev  →  API key
# SERPER_API_KEY=

# YouTube Data API v3. Free, but the DEFAULT quota is only 100 search calls
# PER DAY for the whole project — fine for TestFlight, not for launch. The
# quota-extension form needs a public URL, privacy policy and demo account,
# so file it early: https://support.google.com/youtube/contact/yt_api_form
#   https://console.cloud.google.com → enable "YouTube Data API v3" → key
# YOUTUBE_API_KEY=

# NO-CREDIT-CARD OPTION for the Maps tab. Geoapify is OpenStreetMap data
# behind a real hosted service: 3,000 requests/day free, 5 req/s, commercial
# use permitted, and signup needs NO billing account. Used whenever
# GOOGLE_PLACES_KEY is absent.
#   Trade-off: OSM has no ratings and no open-now, so cards show
#   name + distance + address. Coverage is good for chains and landmarks,
#   patchy for small local businesses.
#   Attribution required: 'Powered by Geoapify' with a link.
#   https://myprojects.geoapify.com  →  free API key
# GEOAPIFY_KEY=

# Google Places API (New) — the Maps tab. Ratings, open-now and photos are
# the Enterprise SKU ($35/1k, 1,000 calls free per month); names/addresses
# alone are Pro ($32/1k, 5,000 free). Also powers the nearby landing state.
#   https://console.cloud.google.com → enable "Places API (New)" → key
# GOOGLE_PLACES_KEY=

# Optional: the weather answer card. Same Cloud project as Places; falls back
# to GOOGLE_PLACES_KEY when unset. $0.15/1k with 10,000 free per month.
#   enable "Weather API" in the same project
# GOOGLE_WEATHER_KEY=

# Optional, off by default: a self-hosted Overpass instance for keyless
# "near me" category search. The public one regularly times out at 13s,
# which is worse than no result inside a keyboard.
# OVERPASS_API_BASE=https://overpass.yourhost.dev/api/interpreter

# With NO web key the Search tab is answers-only: the computed cards
# (arithmetic, sunset, time, currency, Wikipedia) still work and a tail row
# hands off to Google. It never shows a fabricated result list.
# OpenStreetMap place search is a DEVELOPMENT fallback, disabled when
# NODE_ENV=production — OSM caps the whole server at 1 request/second.

# Paywall picks set the plan without an App Store receipt (dev/TestFlight only).
PLAN_SELF_SERVE=false

# Solana RPC for the wallet (Helius, QuickNode...), key included. Only the
# server uses it: the app sends its few RPC calls through POST /wallet/rpc.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<your-helius-key>

# ── Ethereum wallet, names and trading (ETHGlobal Mumbai) ─────────────────
# Each chain has a free public RPC built in (server/src/lib/evm.ts); set one
# of these only to use another node for that chain (a keyed one, say).
# ETH_RPC_URL also serves ENS lookups (GET /names/resolve).
ETH_RPC_URL=
# Base mainnet (8453).
BASE_RPC_URL=
# Arbitrum One (42161).
ARBITRUM_RPC_URL=
# OP Mainnet (10).
OPTIMISM_RPC_URL=
# Unichain (130).
UNICHAIN_RPC_URL=
# Whitechain Sepolia, the L2 testnet (1874).
WHITECHAIN_SEPOLIA_RPC_URL=
# Arkiv testnet (7794095).
ARKIV_TESTNET_RPC_URL=
# Base Sepolia (84532).
BASE_SEPOLIA_RPC_URL=
# Ethereum Sepolia (11155111).
SEPOLIA_RPC_URL=
# Definitive Flash integrator key (flash.definitive.fi); without it /flash/* answers 503.
FLASH_API_KEY=
# Uniswap Trading API key (developers.uniswap.org/dashboard); without it swaps quote Uniswap v3 on-chain.
UNISWAP_API_KEY=

# Private AI: 0G Private Computer (pc.0g.ai → Console → API Keys, trust mode Private).
# Only phones that send X-Glyf-AI: 0g are answered by it.
ZEROG_API_KEY=
