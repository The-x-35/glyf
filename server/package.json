{
  "name": "glyf-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "MOCK_AI=true vitest run",
    "typecheck": "tsc --noEmit",
    "near:quote": "tsx scripts/near-quote.ts",
    "near:pot": "tsx scripts/near-pot.ts"
  },
  "dependencies": {
    "@bonfida/spl-name-service": "^4.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "qrcode": "1.5.4",
    "viem": "^2.57.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
