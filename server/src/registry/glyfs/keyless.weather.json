{
  "id": "keyless.weather",
  "version": 2,
  "name": "Weather",
  "icon": "cloud.sun",
  "input": "field",
  "requires": {
    "fullAccess": true,
    "connectors": [],
    "wallet": false
  },
  "discloses": [
    "the place name in your field, or your approximate location (sent to Open-Meteo)"
  ],
  "vars": {
    "place": ""
  },
  "steps": [
    {
      "id": "s1",
      "type": "tool",
      "tool": "weather.now",
      "args": {
        "place": "{{input}}",
        "lat": "{{lat}}",
        "lon": "{{lon}}"
      },
      "out": "final"
    }
  ],
  "output": {
    "mode": "preview",
    "from": "final"
  }
}
