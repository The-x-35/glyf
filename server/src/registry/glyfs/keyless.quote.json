{
  "id": "keyless.quote",
  "version": 2,
  "name": "Quote lookup",
  "icon": "chart.line.uptrend.xyaxis",
  "input": "field",
  "requires": { "fullAccess": true, "connectors": [], "wallet": false },
  "discloses": ["the coin or ticker in your field (sent to Jupiter)"],
  "vars": {},
  "steps": [
    { "id": "s1", "type": "tool", "tool": "quote.crypto", "args": { "symbol": "{{input}}" }, "out": "final" }
  ],
  "output": { "mode": "preview", "from": "final" }
}
